include("${CMAKE_CURRENT_LIST_DIR}/../cmake/common/buildspec_common.cmake")
function(check target windows release_only expected)
  set(OBS_COMPATIBILITY_TARGET "${target}")
  set(OS_WINDOWS "${windows}")
  set(TIMELINE_OBS_SDK_RELEASE_ONLY "${release_only}")
  _timeline_sdk_configurations(actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected SDK configurations: ${actual}; expected ${expected}")
  endif()
endfunction()
check(obs33 TRUE TRUE "Release")
check(obs33 TRUE FALSE "Debug;Release")
check(obs32 TRUE FALSE "Debug;Release")
check(obs31 TRUE FALSE "Debug;Release")
check(obs33 FALSE FALSE "Debug;Release")
message(STATUS "PASS: SDK configuration selection")
